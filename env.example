# --- Acesso ao painel pelo celular ---
APP_PASSWORD=escolha-uma-senha
TICK_SECRET=escolha-uma-chave-bem-dificil

# --- Google Places (opcional, complementa o OpenStreetMap; exige cartão de crédito) ---
GOOGLE_API_KEY=
GOOGLE_MONTHLY_LIMIT=900

# --- Redigir mensagens: Gemini grátis (deixe em branco para usar Claude) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# --- Claude: só é obrigatório se WEB_ENRICH=1 ou se GEMINI_API_KEY ficar vazio ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# --- Buscar Instagram/e-mail via IA com busca na web (custa Claude; 0 = desligado) ---
WEB_ENRICH=0

# --- E-mail (SMTP; ex.: Gmail com senha de app) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_NAME=Saulo
EMAIL_DAILY_LIMIT=15

# --- Ritmo do agente ---
DRAFT_PER_CYCLE=5
QUEUE_MAX=30
LLM_DELAY=8
